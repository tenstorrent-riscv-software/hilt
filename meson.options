option(
  'platform-fw',
  type: 'string',
  value: '',
  description: 'Path to a platform-fw FIT to place in nor.img. A placeholder FIT is built if empty.',
)

option(
  'ascalon-fw',
  type: 'string',
  value: '',
  description: 'Path to an ascalon-fw FIT to place in nor.img. Left out of nor.img if empty.',
)

option(
  'frequency',
  type: 'integer',
  min: 0,
  value: 0,
  description: 'System clock in Hz. By default 24MHz.',
)

option(
  'baud',
  type: 'integer',
  min: 1,
  value: 9600,
  description: 'Console UART baud rate.',
)

option(
  'platform',
  type: 'combo',
  choices: ['silicon', 'haps-boot', 'haps-pcie'],
  value: 'silicon',
  description: 'Platform to build for. silicon also covers QEMU.',
)
